{
  "name": "fvp",
  "version": "0.33.1",
  "summary": "libmdk based Flutter video player plugin",
  "description": "Flutter video player plugin.",
  "homepage": "https://mediadevkit.com",
  "license": {
    "file": "../LICENSE"
  },
  "authors": {
    "Wang Bin": "wbsecg1@gmail.com"
  },
  "compiler_flags": [
    "-Wno-documentation",
    "-std=c++20"
  ],
  "frameworks": "AVFoundation",
  "osx": {
    "frameworks": "FlutterMacOS",
    "dependencies": {
      "FlutterMacOS": []
    }
  },
  "source": {
    "path": "."
  },
  "source_files": "Classes/**/*",
  "public_header_files": "Classes/**/*.h",
  "ios": {
    "dependencies": {
      "Flutter": []
    }
  },
  "platforms": {
    "ios": "12.0",
    "osx": "10.13"
  },
  "dependencies": {
    "mdk": [
      "~> 0.33.1"
    ]
  },
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES"
  },
  "resource_bundles": {
    "fvp_privacy": [
      "PrivacyInfo.xcprivacy"
    ]
  },
  "swift_versions": "5.0",
  "swift_version": "5.0"
}
