CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
EXCLUDED_ARCHS[sdk=*simulator*] = i386
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/DKImagePickerController" "${PODS_CONFIGURATION_BUILD_DIR}/DKPhotoGallery" "${PODS_CONFIGURATION_BUILD_DIR}/OrderedSet" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftyGif" "${PODS_CONFIGURATION_BUILD_DIR}/app_links" "${PODS_CONFIGURATION_BUILD_DIR}/cupertino_http" "${PODS_CONFIGURATION_BUILD_DIR}/device_info_plus" "${PODS_CONFIGURATION_BUILD_DIR}/file_picker" "${PODS_CONFIGURATION_BUILD_DIR}/flutter_avif_ios" "${PODS_CONFIGURATION_BUILD_DIR}/flutter_inappwebview_ios" "${PODS_CONFIGURATION_BUILD_DIR}/flutter_keyboard_visibility" "${PODS_CONFIGURATION_BUILD_DIR}/flutter_secure_storage" "${PODS_CONFIGURATION_BUILD_DIR}/fvp" "${PODS_CONFIGURATION_BUILD_DIR}/http_proxy" "${PODS_CONFIGURATION_BUILD_DIR}/local_auth_darwin" "${PODS_CONFIGURATION_BUILD_DIR}/media_kit_libs_ios_video" "${PODS_CONFIGURATION_BUILD_DIR}/media_kit_video" "${PODS_CONFIGURATION_BUILD_DIR}/objective_c" "${PODS_CONFIGURATION_BUILD_DIR}/package_info_plus" "${PODS_CONFIGURATION_BUILD_DIR}/path_provider_foundation" "${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple" "${PODS_CONFIGURATION_BUILD_DIR}/share_plus" "${PODS_CONFIGURATION_BUILD_DIR}/sqflite_darwin" "${PODS_CONFIGURATION_BUILD_DIR}/url_launcher_ios" "${PODS_CONFIGURATION_BUILD_DIR}/vibration" "${PODS_CONFIGURATION_BUILD_DIR}/video_player_avfoundation" "${PODS_CONFIGURATION_BUILD_DIR}/volume_controller" "${PODS_CONFIGURATION_BUILD_DIR}/wakelock_plus" "${PODS_ROOT}/../.symlinks/plugins/flutter_avif_ios/ios/Frameworks" "${PODS_ROOT}/../.symlinks/plugins/media_kit_libs_ios_video/ios/Frameworks" "${PODS_ROOT}/mdk/mdk-sdk/lib" "${PODS_XCFRAMEWORKS_BUILD_DIR}/mdk" "${PODS_XCFRAMEWORKS_BUILD_DIR}/media_kit_libs_ios_video"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/DKImagePickerController/DKImagePickerController.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DKPhotoGallery/DKPhotoGallery.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/OrderedSet/OrderedSet.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage/SDWebImage.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftyGif/SwiftyGif.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/app_links/app_links.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/cupertino_http/cupertino_http.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/device_info_plus/device_info_plus.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/file_picker/file_picker.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/flutter_avif_ios/flutter_avif_ios.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/flutter_inappwebview_ios/flutter_inappwebview_ios.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/flutter_keyboard_visibility/flutter_keyboard_visibility.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/flutter_secure_storage/flutter_secure_storage.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/fvp/fvp.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/http_proxy/http_proxy.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/local_auth_darwin/local_auth_darwin.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/media_kit_libs_ios_video/media_kit_libs_ios_video.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/media_kit_video/media_kit_video.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/objective_c/objective_c.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/package_info_plus/package_info_plus.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/path_provider_foundation/path_provider_foundation.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple/permission_handler_apple.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/share_plus/share_plus.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/sqflite_darwin/sqflite_darwin.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/url_launcher_ios/url_launcher_ios.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/vibration/vibration.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/video_player_avfoundation/video_player_avfoundation.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/volume_controller/volume_controller.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/wakelock_plus/wakelock_plus.framework/Headers" "${PODS_XCFRAMEWORKS_BUILD_DIR}/flutter_avif_ios/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift
LIBRARY_SEARCH_PATHS = $(inherited) $(SDKROOT)/usr/lib/swift $(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)/ $(SDKROOT)/usr/lib/swift
OTHER_LDFLAGS = $(inherited) -l"swiftCoreGraphics" -framework "AVFoundation" -framework "AVKit" -framework "Ass" -framework "Avcodec" -framework "Avfilter" -framework "Avformat" -framework "Avutil" -framework "DKImagePickerController" -framework "DKPhotoGallery" -framework "Dav1d" -framework "Foundation" -framework "Freetype" -framework "Fribidi" -framework "Harfbuzz" -framework "ImageIO" -framework "Mbedcrypto" -framework "Mbedtls" -framework "Mbedx509" -framework "Mpv" -framework "OrderedSet" -framework "Photos" -framework "Png16" -framework "SDWebImage" -framework "SwiftyGif" -framework "Swresample" -framework "Swscale" -framework "UIKit" -framework "Uchardet" -framework "Xml2" -framework "app_links" -framework "cupertino_http" -framework "device_info_plus" -framework "file_picker" -framework "flutter_avif_ios" -framework "flutter_inappwebview_ios" -framework "flutter_keyboard_visibility" -framework "flutter_secure_storage" -framework "fvp" -framework "http_proxy" -framework "local_auth_darwin" -framework "mdk" -framework "media_kit_libs_ios_video" -framework "media_kit_video" -framework "objective_c" -framework "package_info_plus" -framework "path_provider_foundation" -framework "share_plus" -framework "sqflite_darwin" -framework "url_launcher_ios" -framework "vibration" -framework "video_player_avfoundation" -framework "volume_controller" -framework "wakelock_plus" -weak_framework "LinkPresentation"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
